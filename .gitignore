# ==============================================================================
# ZipForge — .gitignore
# ==============================================================================

# --- Python Bytecode & Cache ---
__pycache__/
*.py[cod]
*$py.class
*.so
*.pyd
*.pyo
.Python

# --- Virtual Environments ---
.venv/
venv/
ENV/
env/
env.bak/
venv.bak/
*.venv/

# --- Streamlit ---
# Keep config.toml (theme/server settings), ignore sensitive secrets & cache
.streamlit/secrets.toml
backend/.streamlit/secrets.toml
**/.streamlit/secrets.toml
secrets.toml
**/.streamlit/cache/

# --- Environment Variables & Secrets ---
.env
.env.*
*.env
backend/.env
backend/.env.*
frontend/.env
frontend/.env.*
*.local

# Keep example environment files tracked across root, backend & frontend
!.env.example
!backend/.env.example
!frontend/.env.example
!**/.env.example

# --- Security, Certificates & Sensitive Keys ---
*.pem
*.key
*.cert
*.crt
*.pfx
*.p12

# --- Node & Frontend (Vite / React / TypeScript) ---
node_modules/
frontend/node_modules/
dist/
dist-ssr/
frontend/dist/
frontend/dist-ssr/
.vite/
frontend/.vite/
*.tsbuildinfo
.eslintcache
.oxlint_cache/
.turbo/
.parcel-cache/

# --- Testing, Coverage & Quality ---
.pytest_cache/
.coverage
.coverage.*
htmlcov/
coverage/
.nyc_output/
.hypothesis/
.tox/
.nox/
.mypy_cache/
.ruff_cache/
.cache/
playwright-report/
blob-report/
playwright-artifacts-*/
test-results/

# --- Distribution & Build Artifacts ---
build/
*.egg-info/
*.egg
eggs/
parts/
var/
sdist/
develop-eggs/
.installed.cfg
lib/
lib64/
wheels/
*.whl
share/python-wheels/
*.manifest
*.spec

# --- Logs & Package Manager Dumps ---
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
pip-log.txt
pip-delete-this-directory.txt

# --- Temporary Files, Backups & Runtime Workspace ---
*.tmp
*.bak
*.swp
*.swo
*~
*.patch
fcmp_*/
temp/
tmp/

# --- Operating System Files ---
# Windows
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
desktop.ini
$RECYCLE.BIN/

# macOS
.DS_Store
.DS_Store?
.AppleDouble
.LSOverride
._*
.Spotlight-V100
.Trashes

# Linux
.directory
.fuse_hidden*
.nfs*

# --- IDEs & Code Editors ---
.idea/
.vscode/
*.sublime-project
*.sublime-workspace
*.code-workspace
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
*.iml
*.ipr
*.iws
.project
.classpath
.settings/
